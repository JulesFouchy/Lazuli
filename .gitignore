node_modules/
dist/
src-tauri/target/
src-tauri/binaries/

# `src-tauri/gen/android/` is generated by `tauri android init` and then
# committed, against the usual advice, because we edit it: the manifest wants a
# camera permission, `MainActivity.kt` wants a handler to answer for it, and
# `build.gradle.kts` wants the signing config. Generated files you edit are
# source. These are the parts of it that are not.
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/local.properties
src-tauri/gen/android/keystore.properties
src-tauri/gen/android/**/*.jks
src-tauri/gen/android/**/*.keystore
# Not this one, though: Play refuses a `versionCode` that does not climb, and an
# untracked one starts again from scratch on every fresh checkout.
!src-tauri/gen/android/app/tauri.properties
