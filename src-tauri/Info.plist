<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated Info.plist by the macOS bundler.

  macOS does not refuse a camera request that has no usage string — it kills the
  process. The picker's "Take a photo" button is therefore the difference
  between this file existing and the app disappearing mid-entry.
-->
<plist version="1.0">
  <dict>
    <key>NSCameraUsageDescription</key>
    <string>Lazuli uses the camera to take a picture for a journal entry. The picture is saved in your project folder and sent nowhere.</string>
  </dict>
</plist>
