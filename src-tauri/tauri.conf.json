{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lazuli",
  "version": "0.3.0",
  "identifier": "io.github.julesfouchy.lazuli",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jules Fouchy",
    "copyright": "Copyright © 2026 Jules Fouchy",
    "category": "Productivity",
    "shortDescription": "A local-first project journal.",
    "longDescription": "Lazuli keeps a project journal as a folder on disk: each entry is a dated sentence and a picture, read back as a timeline of the days you worked on it.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RDQzRTcyMjAxNTNDRTAKUldUZ1BCVWdjajdVbFIreDM5MExDalFpMDV3cmMxUWVheE41THJjRkdESFlxeG0zazFtYk0wZ3EK",
      "endpoints": [
        "https://github.com/JulesFouchy/lazuli-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
